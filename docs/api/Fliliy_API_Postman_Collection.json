              "raw": "{\n  \"title\": \"测试商品\",\n  \"description\": \"这是一个测试商品\",\n  \"price\": 100,\n  \"categoryId\": 10,\n  \"condition\": \"NEW\",\n  \"province\": \"北京市\",\n  \"city\": \"北京市\",\n  \"district\": \"朝阳区\",\n  \"hasWarranty\": false,\n  \"images\": [\"https://example.com/test.jpg\"],\n  \"tags\": [\"测试\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": []
