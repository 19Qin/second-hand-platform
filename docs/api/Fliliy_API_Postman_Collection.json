{
  "info": {
    "name": "Fliliy二手平台API",
    "description": "Fliliy二手平台完整API测试集合\n\n**使用说明**:\n1. 导入此文件到Postman\n2. 设置环境变量: baseUrl = http://localhost:8080/api/v1\n3. 先执行认证模块获取Token\n4. Token会自动保存到环境变量\n5. 其他接口会自动使用Token\n\n**测试时间**: 2025-10-10\n**文档版本**: v1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 认证模块",
      "item": [
        {
          "name": "1.1 发送验证码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"13800138000\",\n  \"type\": \"login\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sms/send",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sms", "send"]
            },
            "description": "发送短信验证码\n\n**注意**: type必须小写(login/register/reset)"
          },
          "response": []
        },
        {
          "name": "1.2 验证码登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.code === 200) {",
                  "        pm.environment.set('accessToken', jsonData.data.accessToken);",
                  "        pm.environment.set('refreshToken', jsonData.data.refreshToken);",
                  "        console.log('Token已保存');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"13800138000\",\n  \"smsCode\": \"5379\",\n  \"smsId\": \"sms_20251010195454_192\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/sms",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", "sms"]
            },
            "description": "使用验证码登录,Token会自动保存到环境变量"
          },
          "response": []
        },
        {
          "name": "1.3 刷新Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "1.4 退出登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
